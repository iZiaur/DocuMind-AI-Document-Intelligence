# Database Configuration (Docker Compose pgvector)
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind_password
POSTGRES_DB=documind_db
POSTGRES_PORT=5432

# Backend Database Connection URL
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://documind:documind_password@localhost:5432/documind_db

# FastAPI Server Settings
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173

# Authentication & Security
JWT_SECRET=documind_super_secret_jwt_key_for_development_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Environment Mode ('development', 'test', or 'production')
DOCUMIND_ENV=development

# Document Storage & Upload Policy
UPLOAD_DIR=storage/documents
MAX_UPLOAD_SIZE_MB=10

# In-Memory Rate Limiting (SEC-04)
# Note: For multi-instance production clusters, terminate rate limiting at reverse proxy / Redis layer
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_RAG_PER_MINUTE=20
RATE_LIMITER_MAX_KEYS=10000
TRUSTED_PROXIES=127.0.0.1,::1,localhost

# LLM / Embedding Provider Configurations
# EMBEDDING_PROVIDER: 'gemini', 'openai', or 'offline'
EMBEDDING_PROVIDER=gemini
# GENERATION_PROVIDER: 'gemini', 'openai', or 'offline'
GENERATION_PROVIDER=gemini

# Gemini Provider Settings
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_DIMENSION=1536

# OpenAI Provider Settings
OPENAI_API_KEY=your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
